{
	"name": "diet",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts",
		"db:migrate:local": "wrangler d1 migrations apply diet --local",
		"db:migrate:remote": "wrangler d1 migrations apply diet --remote"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260903.1",
		"@sveltejs/adapter-cloudflare": "^7.0.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^2.1.8",
		"wrangler": "^4.0.0"
	},
	"dependencies": {
		"jose": "^5.9.6",
		"ulid": "^2.3.0"
	}
}
